{
  "name": "s3-usage-siyuan",
  "version": "1.0.1",
  "description": "View object storage bucket usage in SiYuan",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite build --watch --mode development",
    "build": "vite build && node scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:package": "node scripts/verify-package.mjs",
    "render:icon": "node scripts/render-icon.mjs",
    "render:preview": "node scripts/render-preview.mjs"
  },
  "keywords": [
    "siyuan",
    "siyuan-plugin",
    "s3",
    "object storage",
    "bucket usage",
    "阿里云 OSS",
    "腾讯云 COS",
    "华为云 OBS",
    "火山引擎 TOS",
    "七牛云",
    "MinIO",
    "Cloudflare R2",
    "AWS S3",
    "桶用量"
  ],
  "author": "wmy2981",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "archiver": "^7.0.1",
    "playwright": "^1.63.0",
    "sass-embedded": "^1.104.1",
    "sharp": "^0.35.5",
    "siyuan": "^1.3.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  },
  "dependencies": {
    "fast-xml-parser": "^5.12.1"
  },
  "overrides": {
    "glob@>=10.0.0 <14.0.2": "^14.0.2",
    "minimatch@<11.0.1": "^11.0.5"
  }
}
